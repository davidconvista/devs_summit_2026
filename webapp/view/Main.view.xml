<mvc:View controllerName="devssummit2026.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}"
		class="sapUiContentPadding sapUiResponsivePadding--header sapUiResponsivePadding--subHeader sapUiResponsivePadding--content sapUiResponsivePadding--footer">
        <!-- Search field to filter data -->
		<SearchField width="100%" search=".onSearch" />
		<!-- ComboBox para filtrar monedas -->
		<ComboBox
				change=".onSelectingCurrency"
				showClearIcon="true"
				showSecondaryValues="true"
				filterSecondaryValues= "true"
				items="{
					path: '/I_CurrencyText',
					sorter: { path: 'Currency' },
					filters: [
						{
							path: 'Language',
							operator: 'EQ',
							value1: 'EN'
						}
					]
				}">
			<core:ListItem key="{Currency}" text="{CurrencyShortName}" additionalText = "{Currency}"/>
		</ComboBox>
        <Table id="testTable" items="{/ZC_FOREX_CURRENCY}" class="sapUiSmallMarginTop" mode="SingleSelectLeft" growing="true" growingThreshold="100">
            <columns>
			<Column
				width="12em">
				<Text text="{i18n>moneda}" />
			</Column>
			<Column
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Center">
				<Text text="{i18n>simbolo}" />
			</Column>
			<Column
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Center">
				<Text text="{i18n>region}" />
			</Column>
			<Column
				hAlign="End">
				<Text text="{i18n>tasaUSD}" />
			</Column>
			<Column
				hAlign="Center">
				<Text text="{i18n>estado}" />
			</Column>
            <Column
				hAlign="Begin">
				<Text text="{i18n>lastSync}" />
			</Column>
		</columns>
		<items>
			<ColumnListItem vAlign="Middle" type="Navigation" press=".onCurrencyPress">
				<cells>
					<ObjectIdentifier
						title="{Moneda}"
						text="{Nombre}"/>
					<Text
						text="{Simbolo}" />
					<Text
						text="{Region}" />
					<Text
						text="{path: 'TasaUSD', type: 'sap.ui.model.type.Float', formatOptions: { decimals: 2}}" />
					<core:Icon
						src="{path: 'Status', formatter: '.formatter.statusIcon'}" color="{path: 'Status', formatter: '.formatter.statusIconColor'}"/>
					<!-- <Text
						text="{LastSync}" /> -->
                    <Text
						text="{path: 'LastSync',type:'sap.ui.model.type.Date',formatOptions: { UTC: true, pattern: 'dd.MM.yyyy'}}" />
				</cells>
			</ColumnListItem>
		</items>
        </Table>
		<footer>
			<OverflowToolbar>
				<!-- <Button
					icon="sap-icon://alert"
					text="{= ${message>/}.length }"
					visible="{= ${message>/}.length > 0 }"
					type="Emphasized"
					press=".onMessagePopoverPress" /> -->
				<Button text="{i18n>uploadData}" type="Accept" press="onUploadData"/>
				<Button text="{i18n>getUSDRate}" type="Reject" press="onGetTasaUSD"/>
				<ToolbarSpacer/>
				<Button text="{i18n>goToSmartView}"  type="Emphasized" press="onNavigateToSmartView"/>
				<!-- <Button text="Crear" press="onCreateTest"/>
				<Button text="Borrar" press="onDeleteTest"/> -->
			</OverflowToolbar>
		</footer>
    </Page>
</mvc:View>